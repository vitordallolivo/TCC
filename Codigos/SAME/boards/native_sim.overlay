/*
 * Overlay de devicetree para `west build -b native_sim` — substitui os DOIS
 * ADCs custom da SAME por emuladores in-tree (zephyr,adc-emul), com os MESMOS
 * nodelabels `adc1`/`adc2` que same_board.dts usa. Assim HAL.c roda SEM
 * MUDANÇA: só enxerga "dois adc" via API genérica do Zephyr
 * (adc_channel_setup/adc_read_async).
 *
 *   adc1 → tensões de fase (canais 0,1,2 = V_a,V_b,V_c)
 *   adc2 → correntes de fase (canais 3,4,5 = i_a,i_b,i_c)
 *
 * nchannels = <6> cobre até o maior índice de canal usado (5). Os valores de
 * mV de cada canal são alimentados em runtime por um stimulus (ver
 * adc_stimulus em HAL.c) via adc_emul_const_value_set().
 */

/ {
    adc1: adc_emul_1 {
        compatible = "zephyr,adc-emul";
        nchannels = <6>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        status = "okay";
    };

    adc2: adc_emul_2 {
        compatible = "zephyr,adc-emul";
        nchannels = <6>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        status = "okay";
    };
};

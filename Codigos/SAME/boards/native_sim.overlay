#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * Overlay de devicetree para `west build -b native_sim` — substitui os DOIS
 * ADCs custom da SAME por emuladores in-tree (zephyr,adc-emul), com os MESMOS
 * nodelabels `adc1`/`adc2` que same_board.dts usa. Assim HAL.c roda SEM
 * MUDANÇA: só enxerga "dois adc" via API genérica do Zephyr
 * (adc_channel_setup/adc_read_async).
 *
 *   adc1 → tensões de fase (canais 0,1,2 = V_a,V_b,V_c)
 *   adc2 → correntes de fase (canais 3,4,5 = i_a,i_b,i_c)
 *
 * nchannels = <6> cobre até o maior índice de canal usado (5). Os valores de
 * mV de cada canal são alimentados em runtime por um stimulus (ver
 * adc_stimulus em HAL.c) via adc_emul_const_value_set().
 */

/ {
    adc1: adc_emul_1 {
        compatible = "zephyr,adc-emul";
        nchannels = <6>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        status = "okay";
    };

    adc2: adc_emul_2 {
        compatible = "zephyr,adc-emul";
        nchannels = <6>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        status = "okay";
    };
};

/*
 * LEDs de status e barramento do EEPROM sobre os emuladores do native_sim.
 *
 * Security_Manager.c/NCI.c usam `led_red`/`led_green` e src/main.c usa `i2c2`
 * com as macros de devicetree direto, sem guarda #ifdef CONFIG_ARCH_POSIX —
 * sem estes nós o build de native_sim não liga. Na same_board são PA15, PB4 e
 * PB10/PB11; aqui, pinos do gpio_emul a partir do 1 (o 0 já é o led_0 que a
 * própria native_sim declara) e um i2c-emul sem dispositivos no barramento
 * (NVM_Init falha e o firmware segue com os defaults de fábrica).
 */
&leds {
    led_red: led_red {
        gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
        label = "LED vermelho (emulado)";
    };

    led_green: led_green {
        gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        label = "LED verde (emulado)";
    };
};

/ {
    i2c2: i2c@120 {
        compatible = "zephyr,i2c-emul-controller";
        reg = <0x120 4>;
        clock-frequency = <I2C_BITRATE_STANDARD>;
        #address-cells = <1>;
        #size-cells = <0>;
        #forward-cells = <1>;
        status = "okay";
    };
};

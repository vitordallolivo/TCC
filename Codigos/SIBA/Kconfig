mainmenu "SIBA Firmware"

source "Kconfig.zephyr"

menu "SIBA application"

config SIBA_NET_STATUS_UART
	bool "Imprime status de rede e telemetria na UART a cada 5 s"
	default n
	help
	  Quando habilitado, um worker na siba_wq imprime a cada 5 s:
	  status da conexão, IP configurado, células de carga, bateria,
	  rpm e error_code. Útil para bancada sem a GUI conectada.

endmenu

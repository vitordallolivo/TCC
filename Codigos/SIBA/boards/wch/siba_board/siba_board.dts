/dts-v1/;
#include <wch/ch32v307/ch32v307vc.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/ch32v20x_30x-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/clock/ch32v20x_30x-clocks.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

#define CH32V20X_V30X_PINMUX_ADC1_RM 0

/ {
    model = "SIBA Board";
    compatible = "wch,ch32v307";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
    };

    aliases {
        led0 = &ready_pin;
        relay0 = &relay_batt;
    };

    /* PE15 - uso DUPLO confirmado no esquematico: alem de LED de status
     * (ready_pin/led0), o mesmo sinal alimenta a porta logica AND como
     * MCU_Sig_Ready - a porta AND combina esse sinal com outra condicao de
     * seguranca e sua saida (PD2, ver gpio_pd2_and_out abaixo) habilita o
     * SSR de 100A. Ou seja: o "sistema pronto" do MCU e literalmente uma
     * das duas condicoes para a placa permitir corrente alta no contator. */
    leds {
        compatible = "gpio-leds";
        ready_pin: ready_pin {
            gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
            label = "System Ready LED / MCU_Sig_Ready (porta AND -> SSR 100A)";
        };
    };

    gpio_pd2_and_out: gpio-pd2-and-out {
        compatible = "siba,gpio-array";
        gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
    };

    pa8_reserved: pa8-reserved {
        compatible = "siba,gpio-array";
        gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
    };

    relay_batt: relay-batt {
        compatible = "siba,gpio-array";
        gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
    };

    relays_generic: relays-generic {
        compatible = "siba,gpio-array";
        gpios = <&gpiob 11 GPIO_ACTIVE_HIGH>,
                <&gpiob 12 GPIO_ACTIVE_HIGH>,
                <&gpiob 13 GPIO_ACTIVE_HIGH>,
                <&gpiob 14 GPIO_ACTIVE_HIGH>;
    };

    adc1: adc@40012400 {
        compatible = "wch,adc";
        reg = <0x40012400 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_ADC1>;
        interrupt-parent = <&pfic>;
        interrupts = <34>;
        dmas = <&dma1 1>;
        dma-names = "rx";
        pinctrl-0 = <&adc1_default>;
        pinctrl-names = "default";
        status = "okay";
        #io-channel-cells = <1>;
    };

    tim3: timer@40000400 {
        compatible = "wch,gptm";
        reg = <0x40000400 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_TIM3>;
        interrupt-parent = <&pfic>;
        interrupts = <45>;
        channels = <4>;
        status = "okay";
        prescaler = <0>;
    };

    tim4: timer@40000800 {
        compatible = "wch,gptm";
        reg = <0x40000800 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_TIM4>;
        interrupt-parent = <&pfic>;
        interrupts = <46>;
        channels = <4>;
        prescaler = <143>;
        status = "okay";

        pwm4: pwm {
            compatible = "wch,gptm-pwm";
            #pwm-cells = <3>;
            pinctrl-0 = <&tim4_ch1_default>;
            pinctrl-names = "default";
            status = "okay";
        };
    };

    esc_motor: esc-motor {
        compatible = "siba,pwm-consumer";
        pwms = <&pwm4 1 PWM_USEC(20000) PWM_POLARITY_NORMAL>;
    };

    hx711_sck_pins: hx711-sck-pins {
        compatible = "siba,gpio-array";
        gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>,
                <&gpioe 3 GPIO_ACTIVE_HIGH>,
                <&gpioe 4 GPIO_ACTIVE_HIGH>,
                <&gpioe 5 GPIO_ACTIVE_HIGH>,
                <&gpioe 6 GPIO_ACTIVE_HIGH>,
                <&gpioe 7 GPIO_ACTIVE_HIGH>;
    };

    rpm_capture_pin: rpm-capture-pin {
        compatible = "siba,gpio-array";
        gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
    };

    hx711_dout_pins: hx711-dout-pins {
        compatible = "siba,gpio-array";
        gpios = <&gpioe 8 GPIO_ACTIVE_HIGH>,
                <&gpioe 9 GPIO_ACTIVE_HIGH>,
                <&gpioe 10 GPIO_ACTIVE_HIGH>,
                <&gpioe 11 GPIO_ACTIVE_HIGH>,
                <&gpioe 12 GPIO_ACTIVE_HIGH>,
                <&gpioe 13 GPIO_ACTIVE_HIGH>;
    };

};

/* ==================================================================== *
 * PINCTRL                                                               *
 * ==================================================================== */

&pinctrl {

    adc1_default: adc1_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 0, ADC1, 0)>;   /* CH0 - v_batt */
        };
        group2 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 1, ADC1, 0)>;   /* CH1 - i_batt */
        };
        group3 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 2, ADC1, 0)>;   /* CH2 - air_speed */
        };
        group4 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 6, ADC1, 0)>;   /* CH6 - temperature_battery */
        };
    };

    i2c1_default: i2c1_default {
        group1 {
            pinmux = <I2C1_SCL_PB8_1>;
            bias-pull-up;
            drive-open-drain;
        };
        group2 {
            pinmux = <I2C1_SDA_PB9_1>;
            bias-pull-up;
            drive-open-drain;
        };
    };

    usart1_default: usart1_default {
        group1 {
            pinmux = <USART1_TX_PA9_0>;
            output-high;
            drive-push-pull;
            slew-rate = "max-speed-10mhz";
        };
        group2 {
            pinmux = <USART1_RX_PA10_0>;
            bias-pull-up;
        };
    };

    tim3_ch3_pb0: tim3_ch3_pb0 {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PB, 0, TIM3, 0)>;
            bias-pull-up;
        };
    };

    tim4_ch1_default: tim4_ch1_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PB, 6, TIM4, 0)>;
            drive-push-pull;
            slew-rate = "max-speed-50mhz";
        };
    };

    mac_default: mac_default {
        mac_internal_rxp {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 6, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_rxn {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 7, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_txp {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 8, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_txn {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 9, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
    };

    mdio_default: mdio_default {
        /* PHY interno - sem pinos MDIO externos necessarios */
    };
};

/* ==================================================================== *
 * HARDWARE EXISTENTE                                                    *
 * ==================================================================== */

&clk_hse {
    status = "okay";
};

&pll {
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
};

&gpioa { status = "okay"; };
&gpiob { status = "okay"; };
&gpioc { status = "okay"; };
&gpiod { status = "okay"; };
&gpioe { status = "okay"; };
&dma1  { status = "okay"; };

&usart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&usart1_default>;
    pinctrl-names = "default";
};

/* FIX 1: habilita o controller pai - sem isso o clock do MAC nunca sobe
 * e o driver trava antes de qualquer log aparecer no serial. */
&eth {
    status = "okay";
};

/* FIX 2: local-mac-address - sem isso o driver tenta ler da OTP interna;
 * se zerada (chip novo/apagado), entra em loop e o watchdog reinicia.
 * FIX 3: internal-phy-pllmul/prediv explicitos - HSE 8MHz / prediv2=2 *
 * pllmul=15 = 60MHz para o PHY interno. Ja vem do dtsi mas declarados
 * aqui para garantir independencia de versao do dtsi. */
&mac {
    status = "okay";
    pinctrl-0 = <&mac_default>;
    pinctrl-names = "default";
    phy-connection-type = "internal";
    phy-handle = <&eth_phy>;
    local-mac-address = [02 00 00 01 02 03];
    internal-phy-pllmul = "15";
    internal-phy-prediv = "2";
};

&mdio {
    status = "okay";
    pinctrl-0 = <&mdio_default>;
    pinctrl-names = "default";
    eth_phy: ethernet-phy@0 {
        compatible = "ethernet-phy";
        reg = <0x00>;
    };
};

&rng {
    status = "okay";
};

&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

&sram0 {
    reg = <0x20000000 DT_SIZE_K(128)>;
};

&flash0 {
    reg = <0x08000000 DT_SIZE_K(198)>;
};

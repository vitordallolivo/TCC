/dts-v1/;
#include <wch/ch32v307/ch32v307vc.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/ch32v20x_30x-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/clock/ch32v20x_30x-clocks.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/spi/spi.h>

#define CH32V20X_V30X_PINMUX_ADC1_RM 0
#define CH32V20X_V30X_PINMUX_ADC2_RM 0
/* I2C2 não tem remap no AFIO (pinos fixos PB10/PB11) */
#define CH32V20X_V30X_PINMUX_I2C2_RM 0

/ {
    model = "SIBA Board";
    compatible = "wch,ch32v307";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
    };

    aliases {
        led0 = &ready_pin;
    };

    /* PE15 — LED de status + MCU_Sig_Ready (porta AND → SSR 100 A).
     * Mesmo pino cumpre dois papéis: indica "sistema pronto" ao operador
     * e habilita o SSR via porta lógica AND (PD2 é a outra entrada). */
    leds {
        compatible = "gpio-leds";
        ready_pin: ready_pin {
            gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
            label = "System Ready LED / MCU_Sig_Ready";
        };
    };

    /* PD2 — saída da porta AND que aciona o SSR de 100 A.
     * Precisa de PE15=1 (MCU pronto) E PD2=1 (confirmação de sequência)
     * para fechar o SSR — proteção de dois fatores. */
    gpio_pd2_and_out: gpio-pd2-and-out {
        compatible = "siba,gpio-array";
        gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
    };

    /* ── Relés de potência ─────────────────────────────────────────────── *
     * Sequência de energização obrigatória (ver Security_Manager):         *
     *   LIGAR:   relay_precharge ON → espera 3 s → relay_power ON         *
     *   DESLIGAR: relay_power OFF → relay_precharge OFF                   *
     * A pré-carga limita a corrente de inrush nos capacitores do ESC.    */
    relay_power: relay-power {
        compatible = "siba,gpio-array";
        gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;
    };

    relay_precharge: relay-precharge {
        compatible = "siba,gpio-array";
        gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
    };

    /* ── ADC dual simultâneo (master=ADC1, slave=ADC2) ─────────────────── *
     * ADC1 master: PA0=Pitot, PA1=termistor_bat, PA3=termistor_motor       *
     * ADC2 slave:  PC3=v_batt, PC4=i_batt, PC2=reserva                    *
     * ADC2 não tem linha DMA própria no CH32V307 — o resultado sai pela    *
     * transferência de 32 bits do ADC1 (bits [31:16]=ADC2, [15:0]=ADC1).  *
     * O driver detecta modo dual pela ausência de `dmas` no nó adc2.      */
    adc1: adc@40012400 {
        compatible = "wch,adc";
        reg = <0x40012400 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_ADC1>;
        interrupt-parent = <&pfic>;
        interrupts = <34>;
        dmas = <&dma1 1>;
        dma-names = "rx";
        pinctrl-0 = <&adc1_default>;
        pinctrl-names = "default";
        status = "okay";
        #io-channel-cells = <1>;
    };

    adc2: adc@40012800 {
        compatible = "wch,adc";
        reg = <0x40012800 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_ADC2>;
        interrupt-parent = <&pfic>;
        interrupts = <34>;
        pinctrl-0 = <&adc2_default>;
        pinctrl-names = "default";
        status = "okay";
        #io-channel-cells = <1>;
    };

    /* ── HX711 × 6 células de carga ────────────────────────────────────── *
     * PE0..PE5 = PD_SCK (clock, saída)  — uma por célula                   *
     * PE6..PE11 = DOUT  (dado serial, entrada) — uma por célula            */
    hx711_sck_pins: hx711-sck-pins {
        compatible = "siba,gpio-array";
        gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>,
                <&gpioe 1 GPIO_ACTIVE_HIGH>,
                <&gpioe 2 GPIO_ACTIVE_HIGH>,
                <&gpioe 3 GPIO_ACTIVE_HIGH>,
                <&gpioe 4 GPIO_ACTIVE_HIGH>,
                <&gpioe 5 GPIO_ACTIVE_HIGH>;
    };

    hx711_dout_pins: hx711-dout-pins {
        compatible = "siba,gpio-array";
        gpios = <&gpioe 6  GPIO_ACTIVE_HIGH>,
                <&gpioe 7  GPIO_ACTIVE_HIGH>,
                <&gpioe 8  GPIO_ACTIVE_HIGH>,
                <&gpioe 9  GPIO_ACTIVE_HIGH>,
                <&gpioe 10 GPIO_ACTIVE_HIGH>,
                <&gpioe 11 GPIO_ACTIVE_HIGH>;
    };

    /* ── RPM (TIM3 CH3 / PB0, input capture) ────────────────────────── */
    rpm_capture_pin: rpm-capture-pin {
        compatible = "siba,gpio-array";
        gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
    };

    /* ── ESC PWM (TIM4 CH1 / PB6, 50 Hz) ───────────────────────────── */
    tim3: timer@40000400 {
        compatible = "wch,gptm";
        reg = <0x40000400 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_TIM3>;
        interrupt-parent = <&pfic>;
        interrupts = <45>;
        channels = <4>;
        status = "okay";
        prescaler = <0>;
    };

    tim4: timer@40000800 {
        compatible = "wch,gptm";
        reg = <0x40000800 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_TIM4>;
        interrupt-parent = <&pfic>;
        interrupts = <46>;
        channels = <4>;
        prescaler = <143>;
        status = "okay";

        pwm4: pwm {
            compatible = "wch,gptm-pwm";
            #pwm-cells = <3>;
            pinctrl-0 = <&tim4_ch1_default>;
            pinctrl-names = "default";
            status = "okay";
        };
    };

    esc_motor: esc-motor {
        compatible = "siba,pwm-consumer";
        pwms = <&pwm4 1 PWM_USEC(20000) PWM_POLARITY_NORMAL>;
    };

};

/* ==================================================================== *
 * PINCTRL                                                               *
 * ==================================================================== */

&pinctrl {

    /* ADC1 master: PA0=CH0(Pitot), PA1=CH1(termistor_bat), PA3=CH3(termistor_motor)
     * PA2 é CS do W25Q — não usar como ADC.
     * PA5/PA6/PA7 são SPI1 (W25Q) — não usar como ADC.                    */
    adc1_default: adc1_default {
        group1 { pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 0, ADC1, 0)>; };  /* CH0  - Pitot (air_speed) */
        group2 { pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 1, ADC1, 0)>; };  /* CH1  - termistor bateria */
        group3 { pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 3, ADC1, 0)>; };  /* CH3  - termistor motor */
    };

    /* ADC2 slave (dual mode, sem DMA próprio):
     * PC3=CH13(v_batt), PC4=CH14(i_batt), PC2=CH12(reserva)
     * PC0/PC1 são LinkLED/ACTLED do PHY ETH interno — não usar como ADC. */
    adc2_default: adc2_default {
        group1 { pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 3, ADC2, 0)>; };  /* CH13 - v_batt */
        group2 { pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 4, ADC2, 0)>; };  /* CH14 - i_batt */
        group3 { pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 2, ADC2, 0)>; };  /* CH12 - reserva */
    };

    /* SPI1 — W25Q flash (PA5=SCK, PA6=MISO, PA7=MOSI; PA2=CS via GPIO) */
    spi1_default: spi1_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 5, SPI1, 0)>;  /* SCK  */
            drive-push-pull;
            slew-rate = "max-speed-50mhz";
        };
        group2 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 6, SPI1, 0)>;  /* MISO */
            bias-pull-up;
        };
        group3 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 7, SPI1, 0)>;  /* MOSI */
            drive-push-pull;
            slew-rate = "max-speed-50mhz";
        };
    };

    /* I2C2 — EEPROM FT24C32A (PB10=SCL, PB11=SDA) + expansão futura.
     * Open-drain com pull-up externo. PB11 não conflita com relay_precharge
     * (PB13) — são pinos distintos.                                       */
    i2c2_default: i2c2_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PB, 10, I2C2, 0)>;
            output-high;
            drive-open-drain;
        };
        group2 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PB, 11, I2C2, 0)>;
            output-high;
            drive-open-drain;
        };
    };

    usart1_default: usart1_default {
        group1 {
            pinmux = <USART1_TX_PA9_0>;
            output-high;
            drive-push-pull;
            slew-rate = "max-speed-10mhz";
        };
        group2 {
            pinmux = <USART1_RX_PA10_0>;
            bias-pull-up;
        };
    };

    tim3_ch3_pb0: tim3_ch3_pb0 {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PB, 0, TIM3, 0)>;
            bias-pull-up;
        };
    };

    tim4_ch1_default: tim4_ch1_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PB, 6, TIM4, 0)>;
            drive-push-pull;
            slew-rate = "max-speed-50mhz";
        };
    };

    mac_default: mac_default {
        mac_internal_rxp {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 6, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_rxn {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 7, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_txp {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 8, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_txn {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 9, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
    };

    mdio_default: mdio_default {
        /* PHY interno — sem pinos MDIO externos */
    };
};

/* ==================================================================== *
 * CLOCKS / PERIFÉRICOS                                                  *
 * ==================================================================== */

&clk_hse { status = "okay"; };
&pll { clocks = <&clk_hse>; status = "okay"; };
&rcc { clocks = <&pll>; };

&gpioa { status = "okay"; };
&gpiob { status = "okay"; };
&gpioc { status = "okay"; };
&gpiod { status = "okay"; };
&gpioe { status = "okay"; };

/* dma1 "disabled" como controller genérico Zephyr: o driver adc_ch32v307.c
 * faz MMIO direto no DMA1, não usa a API genérica. Com dma1 "okay" o
 * dma_wch.c registra seu handler na IRQ27 e o driver ADC sobrescreve depois
 * (race). Manter "disabled" e deixar o driver ADC dono da IRQ.           */
&dma1 { status = "disabled"; };

&usart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&usart1_default>;
    pinctrl-names = "default";
};

&eth { status = "okay"; };

&mac {
    status = "okay";
    pinctrl-0 = <&mac_default>;
    pinctrl-names = "default";
    phy-connection-type = "internal";
    phy-handle = <&eth_phy>;
    local-mac-address = [02 00 00 02 03 03];
    internal-phy-pllmul = "15";
    internal-phy-prediv = "2";
};

&mdio {
    status = "okay";
    pinctrl-0 = <&mdio_default>;
    pinctrl-names = "default";
    eth_phy: ethernet-phy@0 {
        compatible = "ethernet-phy";
        reg = <0x00>;
    };
};

&rng { status = "okay"; };

/* EEPROM FT24C32A (I2C2, 4 KB) — A0=A1=A2=GND → endereço 0x50. */
&i2c2 {
    status = "okay";
    pinctrl-0 = <&i2c2_default>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* SPI1 — W25Q flash (dados de logging / configuração extra).
 * CS gerenciado via GPIO PA2 (GPIO_ACTIVE_LOW, controlado em software).  */
&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-names = "default";
    cs-gpios = <&gpioa 2 GPIO_ACTIVE_LOW>;
};

&sram0 { reg = <0x20000000 DT_SIZE_K(128)>; };
&flash0 { reg = <0x08000000 DT_SIZE_K(198)>; };

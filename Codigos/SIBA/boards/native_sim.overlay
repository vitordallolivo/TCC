#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * Overlay de devicetree para `west build -b native_sim`.
 *
 * Na SIBA, o HAL usa ISR callback do driver adc_ch32v307 (não adc_emul) e
 * o path native_sim contorna o ADC completamente via timer + writes diretos
 * nos atomics adc1_raw[]/adc2_raw[]. Por isso não é necessário nó adc-emul.
 *
 * i2c2 → zephyr,i2c-emul-controller, mesmo nodelabel que siba_board.dts usa
 * (PB10/PB11). Sem dispositivos I2C reais no barramento emulado:
 * HAL_I2C_Read/Write/Scan funcionam, apenas não encontram nada a responder.
 *
 * Relay e GPIO de hardware (PB12/PB13) → stubs #ifdef CONFIG_ARCH_POSIX no
 * HAL.c (sem nó DTS necessário no overlay).
 *
 * ESC/RPM/HX711 continuam com seus blocos #ifdef CONFIG_ARCH_POSIX dentro
 * do HAL.c (sem equivalente in-tree utilizável fora de builds Twister/ztest).
 */

/ {
    i2c2: i2c@120 {
        compatible = "zephyr,i2c-emul-controller";
        reg = <0x120 4>;
        clock-frequency = <I2C_BITRATE_STANDARD>;
        #address-cells = <1>;
        #size-cells = <0>;
        #forward-cells = <1>;
        status = "okay";
    };
};

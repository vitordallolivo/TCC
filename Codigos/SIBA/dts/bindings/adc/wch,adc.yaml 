# Binding DTS para o ADC do CH32V307 (e família CH32V20x/30x)
# Compatível: "wch,adc"

description: WCH CH32V307 ADC controller com suporte a DMA circular

compatible: "wch,adc"

include: [base.yaml, pinctrl-device.yaml]

properties:
  reg:
    required: true

  clocks:
    required: true

  interrupts:
    required: true
    description: |
      IRQ do ADC1/ADC2 (número 34 no CH32V307, usado para EOC por polling
      ou watchdog — o driver usa DMA TC como evento primário).

  dmas:
    required: false
    description: |
      Par (controlador DMA, canal). Ex: <&dma1 1> para DMA1 Canal 1.
      Atualmente o driver usa DMA1 Canal 1 diretamente via MMIO.

  dma-names:
    required: false

  "#io-channel-cells":
    const: 1
    description: Canal ADC (0-15)

io-channel-cells:
  - input
/dts-v1/;
#include <wch/ch32v307/ch32v307vc.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/ch32v20x_30x-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/clock/ch32v20x_30x-clocks.h>

#define CH32V20X_V30X_PINMUX_ADC1_RM 0

/ {
    model = "SPMM Board";
    compatible = "wch,ch32v307";

    chosen {
        zephyr,sram    = &sram0;
        zephyr,flash   = &flash0;
        zephyr,console = &usart1;   /* LOG local para debug de bancada */
    };

    /* ==================================================================
     * MEDICAO COMPLETA — 3 correntes + 3 tensoes de fase (dq real)
     *
     * ADC1 (DMA1 canal 1): correntes de fase
     *   idx 0 -> CH0 / PA0 : Ia
     *   idx 1 -> CH1 / PA1 : Ib
     *   idx 2 -> CH2 / PA2 : Ic
     * ADC2 (DMA1 canal 2): tensoes de fase (para estimar theta_e -> Park)
     *   idx 0 -> CH3 / PA3 : Va
     *   idx 1 -> CH4 / PA4 : Vb
     *   idx 2 -> CH5 / PA5 : Vc
     *
     * Driver custom adc_ch32v307 (NAO o padrao, que conflita com a Ethernet).
     * O driver suporta 2 instancias (ADC1 base 0x40012400, ADC2 base
     * 0x40012800), cada uma com seu proprio canal DMA1.
     *
     * >>> RISCO DE HARDWARE (validar na bancada) <<<
     * Em silicio estilo F103, o ADC2 normalmente NAO possui request de DMA
     * proprio (so ADC1). Se o ADC2 do CH32V307 nao disparar DMA1-ch2, o
     * scan de tensao nao avanca e sera preciso: (a) migrar as tensoes para
     * o ADC1 (6 canais num scan so), ou (b) usar dual-mode simultaneo. Ver
     * CLAUDE.md. As correntes (ADC1) funcionam independentemente disso.
     * ================================================================== */
    adc1: adc@40012400 {
        compatible = "wch,adc";
        reg = <0x40012400 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_ADC1>;
        interrupt-parent = <&pfic>;
        interrupts = <34>;
        dmas = <&dma1 1>;
        dma-names = "rx";
        pinctrl-0 = <&adc1_default>;
        pinctrl-names = "default";
        status = "okay";
        #io-channel-cells = <1>;
    };

    adc2: adc@40012800 {
        compatible = "wch,adc";
        reg = <0x40012800 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_ADC2>;
        interrupt-parent = <&pfic>;
        interrupts = <34>;          /* ADC1_2 compartilham a IRQ; driver usa a do DMA */
        dmas = <&dma1 2>;
        dma-names = "rx";
        pinctrl-0 = <&adc2_default>;
        pinctrl-names = "default";
        status = "okay";
        #io-channel-cells = <1>;
    };

    /* ==================================================================
     * TIM3 CH3 (PB0) — input capture do sensor de rotacao
     *   14 polos -> 7 pulsos/volta (Hall) ou disco optico
     * ================================================================== */
    tim3: timer@40000400 {
        compatible = "wch,gptm";
        reg = <0x40000400 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_TIM3>;
        interrupt-parent = <&pfic>;
        interrupts = <45>;
        channels = <4>;
        status = "okay";
        prescaler = <0>;
    };

    rpm_capture_pin: rpm-capture-pin {
        compatible = "spmm,gpio-array";
        gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
    };

    /* ==================================================================
     * TIM4 CH1 (PB6) — PWM de SERVO para o throttle do ESC
     *   Periodo 20ms (50Hz), pulso 1000-2000us (padrao RC).
     *   prescaler=143 -> 1 tick = 2us @ 72MHz (base de servo, NAO potencia)
     * ================================================================== */
    tim4: timer@40000800 {
        compatible = "wch,gptm";
        reg = <0x40000800 0x400>;
        clocks = <&rcc CH32V20X_V30X_CLOCK_TIM4>;
        interrupt-parent = <&pfic>;
        interrupts = <46>;
        channels = <4>;
        prescaler = <143>;
        status = "okay";

        pwm4: pwm {
            compatible = "wch,gptm-pwm";
            #pwm-cells = <3>;
            pinctrl-0 = <&tim4_ch1_default>;
            pinctrl-names = "default";
            status = "okay";
        };
    };

    esc_motor: esc-motor {
        compatible = "spmm,pwm-consumer";
        pwms = <&pwm4 1 PWM_USEC(20000) PWM_POLARITY_NORMAL>;
    };
};

/* ==================================================================== *
 * PINCTRL                                                               *
 * ==================================================================== */

&pinctrl {

    adc1_default: adc1_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 0, ADC1, 0)>;   /* CH0 - Ia */
        };
        group2 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 1, ADC1, 0)>;   /* CH1 - Ib */
        };
        group3 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 2, ADC1, 0)>;   /* CH2 - Ic */
        };
    };

    adc2_default: adc2_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 3, ADC1, 0)>;   /* CH3 - Va */
        };
        group2 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 4, ADC1, 0)>;   /* CH4 - Vb */
        };
        group3 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PA, 5, ADC1, 0)>;   /* CH5 - Vc */
        };
    };

    usart1_default: usart1_default {
        group1 {
            pinmux = <USART1_TX_PA9_0>;
            output-high;
            drive-push-pull;
            slew-rate = "max-speed-10mhz";
        };
        group2 {
            pinmux = <USART1_RX_PA10_0>;
            bias-pull-up;
        };
    };

    tim4_ch1_default: tim4_ch1_default {
        group1 {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PB, 6, TIM4, 0)>;
            drive-push-pull;
            slew-rate = "max-speed-50mhz";
        };
    };

    mac_default: mac_default {
        mac_internal_rxp {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 6, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_rxn {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 7, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_txp {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 8, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
        mac_internal_txn {
            pinmux = <CH32V20X_V30X_PINMUX_DEFINE(PC, 9, ETH, 0)>;
            slew-rate = "max-speed-50mhz";
        };
    };

    mdio_default: mdio_default {
        /* PHY interno - sem pinos MDIO externos necessarios */
    };
};

/* ==================================================================== *
 * CLOCKS / GPIO / PERIFERICOS                                           *
 * ==================================================================== */

&clk_hse { status = "okay"; };
&pll     { clocks = <&clk_hse>; status = "okay"; };
&rcc     { clocks = <&pll>; };

&gpioa { status = "okay"; };
&gpiob { status = "okay"; };
&gpioc { status = "okay"; };

/* dma1 fica "disabled" como CONTROLLER GENERICO Zephyr (dma_wch.c): o driver
 * custom adc_ch32v307.c NAO usa a API generica de DMA (faz MMIO direto), so
 * precisa da celula "channel" de `dmas = <&dma1 1>` (resolvida em compile
 * time). Deixar dma1 "okay" faria dma_wch e adc_ch32v307 disputarem a mesma
 * IRQ do canal 1 = conflito. Ver comentario identico na SIBA. */
&dma1 { status = "disabled"; };

&usart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&usart1_default>;
    pinctrl-names = "default";
};

/* Ethernet interno (Telnet + log UDP). FIXES herdados da SIBA:
 *  - &eth okay: habilita o controller pai (sobe o clock do MAC).
 *  - local-mac-address fixo: evita leitura da OTP (que, zerada, trava o boot).
 *  - internal-phy-pllmul/prediv: HSE 8MHz / prediv2=2 * pllmul=15 = 60MHz. */
&eth  { status = "okay"; };

&mac {
    status = "okay";
    pinctrl-0 = <&mac_default>;
    pinctrl-names = "default";
    phy-connection-type = "internal";
    phy-handle = <&eth_phy>;
    local-mac-address = [02 00 00 05 02 07];
    internal-phy-pllmul = "15";
    internal-phy-prediv = "2";
};

&mdio {
    status = "okay";
    pinctrl-0 = <&mdio_default>;
    pinctrl-names = "default";
    eth_phy: ethernet-phy@0 {
        compatible = "ethernet-phy";
        reg = <0x00>;
    };
};

&rng { status = "okay"; };

&sram0  { reg = <0x20000000 DT_SIZE_K(128)>; };
&flash0 { reg = <0x08000000 DT_SIZE_K(198)>; };

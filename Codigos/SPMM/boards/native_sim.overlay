/*
 * Overlay de devicetree para `west build -b native_sim` (modo POSIX/mock).
 *
 * O driver custom adc_ch32v307 (MMIO+DMA do CH32V307) nao compila para
 * native_sim. Em vez de arrancar o ADC do codigo, damos um substituto
 * in-tree do Zephyr (zephyr,adc-emul) com o MESMO nodelabel `adc1` que o
 * spmm_board.dts usa — assim acquisition.c continua chamando
 * adc_channel_setup()/adc_read_async() SEM MUDANCA. 2 canais (Ia, Ib).
 *
 * ESC (PWM/TIM4) e RPM (TIM3, MMIO cru) nao tem equivalente in-tree
 * utilizavel em firmware normal (zephyr,fake-pwm depende do framework de
 * teste FFF; TIM3 e' MMIO em endereco fisico fixo). Esses dois ganham um
 * bloco `#ifdef CONFIG_ARCH_POSIX` synthetic dentro do proprio modulo
 * (esc.c / rpm.c) — mesma estrategia da SIBA.
 */

/ {
    adc1: adc_emul_1 {
        compatible = "zephyr,adc-emul";
        nchannels = <2>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        status = "okay";
    };
};
